pkgname=libffi
pkgver=3.4.7
pkgrel=0
pkgdesc="A portable foreign-function interface library."
arch="all"
license="MIT"
url="http://sourceware.org/libffi"
subpackages="${pkgname}-static ${pkgname}-dev ${pkgname}-doc"
source="https://github.com/libffi/libffi/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz"

build() {
    CFLAGS="$CFLAGS -O2" \
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --docdir=/usr/share/doc/libffi \
        --disable-rpath

    make
}

package() {
    make DESTDIR="${pkgdir}" install
}
sha512sums="
